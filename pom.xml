<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wind.integration</groupId>
        <artifactId>wind-integration</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.wind.funds</groupId>
    <artifactId>wind-funds</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>

    <properties>
        <revision>1.0.1-SNAPSHOT</revision>
        <test.ignore.failure>false</test.ignore.failure>
    </properties>

    <modules>
        <module>core</module>
        <module>fx</module>
        <module>ledger</module>
        <module>wallet</module>
        <module>transaction</module>
        <module>reconciliation</module>
        <module>governance</module>
        <module>tests</module>
        <module>dependencies</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-fx-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-ledger-face</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-ledger-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-transaction-face</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-transaction-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-reconciliation-face</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-reconciliation-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-governance-face</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-governance-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-wallet-face</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-wallet-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wind.funds</groupId>
                <artifactId>wind-funds-tests</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.wind.integration</groupId>
            <artifactId>wind-operator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-processor</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.source}</release>
                    <parameters>true</parameters>
                    <encoding>UTF-8</encoding>
                    <!--  完整执行所有 annotation processing 阶段 -->
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <!-- Lombok（需优先于 MapStruct / MyBatis-Flex） -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <!-- MapStruct -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                        </path>
                        <!-- MyBatis-Flex -->
                        <path>
                            <groupId>com.mybatis-flex</groupId>
                            <artifactId>mybatis-flex-processor</artifactId>
                        </path>
                        <!-- Spring Boot Configuration Processor -->
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
